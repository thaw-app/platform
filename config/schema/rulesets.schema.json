{
	"type": "object",
	"properties": {
		"rulesets": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"target": {
						"enum": ["branch", "tag", "push"],
						"type": "string"
					},
					"enforcement": {
						"enum": ["active", "disabled", "evaluate"],
						"type": "string",
						"default": "active"
					},
					"conditions": {
						"type": "object",
						"properties": {
							"refName": {
								"type": "object",
								"properties": {
									"includes": {
										"type": "array",
										"items": {
											"type": "string"
										}
									},
									"excludes": {
										"type": "array",
										"items": {
											"type": "string"
										}
									}
								},
								"required": ["includes"],
								"additionalProperties": false
							},
							"repositoryName": {
								"type": "object",
								"properties": {
									"includes": {
										"type": "array",
										"items": {
											"type": "string"
										},
										"default": ["~ALL"]
									},
									"excludes": {
										"type": "array",
										"items": {
											"type": "string"
										},
										"default": []
									}
								},
								"required": [],
								"additionalProperties": false
							}
						},
						"required": ["refName"],
						"additionalProperties": false
					},
					"rules": {
						"type": "object",
						"properties": {
							"creation": {
								"type": "boolean"
							},
							"update": {
								"type": "boolean"
							},
							"deletion": {
								"type": "boolean"
							},
							"nonFastForward": {
								"type": "boolean"
							},
							"requiredLinearHistory": {
								"type": "boolean"
							},
							"requiredSignatures": {
								"type": "boolean"
							},
							"copilotCodeReview": {
								"type": "object",
								"properties": {
									"reviewDraftPullRequests": {
										"type": "boolean"
									},
									"reviewOnPush": {
										"type": "boolean"
									}
								},
								"required": ["reviewDraftPullRequests", "reviewOnPush"],
								"additionalProperties": false
							},
							"pullRequest": {
								"type": "object",
								"properties": {
									"requiredApprovingReviewCount": {
										"type": "number"
									},
									"dismissStaleReviewsOnPush": {
										"type": "boolean"
									},
									"requireCodeOwnerReview": {
										"type": "boolean"
									},
									"requireLastPushApproval": {
										"type": "boolean"
									},
									"requiredReviewThreadResolution": {
										"type": "boolean"
									},
									"allowedMergeMethods": {
										"type": "array",
										"items": {
											"enum": ["merge", "squash", "rebase"],
											"type": "string"
										}
									}
								},
								"required": [],
								"additionalProperties": false
							},
							"requiredStatusChecks": {
								"type": "object",
								"properties": {
									"enabled": {
										"type": "boolean"
									},
									"requiredChecks": {
										"type": "array",
										"items": {
											"type": "object",
											"properties": {
												"context": {
													"type": "string"
												}
											},
											"required": ["context"],
											"additionalProperties": false
										}
									},
									"acceptAnyOf": {
										"type": "array",
										"items": {
											"type": "string"
										}
									},
									"strictRequiredStatusChecksPolicy": {
										"type": "boolean"
									},
									"doNotEnforceOnCreate": {
										"type": "boolean"
									}
								},
								"required": ["enabled"],
								"additionalProperties": false
							},
							"requiredCodeScanning": {
								"type": "object",
								"properties": {
									"enabled": {
										"type": "boolean"
									},
									"requiredCodeScanningTools": {
										"type": "array",
										"items": {
											"type": "object",
											"properties": {
												"tool": {
													"type": "string"
												},
												"alertsThreshold": {
													"type": "string"
												},
												"securityAlertsThreshold": {
													"type": "string"
												}
											},
											"required": [
												"tool",
												"alertsThreshold",
												"securityAlertsThreshold"
											],
											"additionalProperties": false
										}
									}
								},
								"required": ["enabled"],
								"additionalProperties": false
							},
							"mergeQueue": {
								"type": "object",
								"properties": {
									"enabled": {
										"type": "boolean"
									},
									"mergeMethod": {
										"enum": ["MERGE", "SQUASH", "REBASE"],
										"type": "string"
									},
									"groupingStrategy": {
										"enum": ["ALLGREEN", "HEADGREEN"],
										"type": "string"
									}
								},
								"required": ["enabled"],
								"additionalProperties": false
							},
							"requiredDeployments": {
								"type": "object",
								"properties": {
									"enabled": {
										"type": "boolean"
									},
									"requiredDeploymentEnvironments": {
										"type": "array",
										"items": {
											"type": "string"
										}
									}
								},
								"required": ["enabled"],
								"additionalProperties": false
							}
						},
						"required": [
							"creation",
							"update",
							"deletion",
							"nonFastForward",
							"requiredLinearHistory",
							"requiredSignatures",
							"copilotCodeReview",
							"pullRequest",
							"requiredStatusChecks",
							"requiredCodeScanning",
							"mergeQueue",
							"requiredDeployments"
						],
						"additionalProperties": false
					}
				},
				"required": ["id", "target", "conditions", "rules"],
				"additionalProperties": false
			}
		}
	},
	"required": ["rulesets"],
	"additionalProperties": false,
	"$schema": "http://json-schema.org/draft-07/schema#"
}
